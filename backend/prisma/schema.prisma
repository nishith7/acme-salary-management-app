// Prisma schema. The datasource URL lives in prisma.config.ts (Prisma 7).
// The client is generated inside src/ so `nest build` compiles it into dist/.
//
// Conventions
// - Tables and columns are snake_case (@@map / @map) so raw SQL for the insight
//   queries stays readable. Enum types are mapped the same way.
// - Ids are UUIDs generated by Postgres (gen_random_uuid()).
//
// The schema is built up one table at a time; each addition is reviewed and
// gets its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_ADMIN
  EMPLOYEE

  @@map("user_role")
}

enum Gender {
  FEMALE
  MALE
  OTHER

  @@map("gender")
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED

  @@map("employee_status")
}

/// A login account. Only HR_ADMIN is used in v1; EMPLOYEE is reserved for later self-service.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

/// One refresh token per row. Only the SHA-256 hash is stored, never the token itself.
/// Every token issued by one login shares a family_id; presenting an already-revoked token
/// revokes the whole family (reuse detection).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 hex digest (64 characters).
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is rotated or the user logs out. Null means still active.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Reference data loaded by the seed. One currency per country.
model Country {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ISO 3166-1 alpha-2, upper case (for example IN).
  code         String @unique @db.Char(2)
  name         String
  /// ISO 4217, upper case (for example INR). Several countries may share one.
  currencyCode String @map("currency_code") @db.Char(3)

  employees Employee[]

  @@map("countries")
}

/// Reference data loaded by the seed.
model Department {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  employees Employee[]

  @@map("departments")
}

/// A person ACME employs, or has employed. Leavers are marked TERMINATED and kept,
/// never deleted, so their salary history stays intact; that is why the two relations
/// below restrict deletes.
///
/// There are no secondary indexes yet, on purpose: they are added after the
/// 10,000-employee seed, only where EXPLAIN shows a need, and the before and after
/// are recorded in docs/performance.md.
///
/// status and terminated_on belong together (TERMINATED has a date, ACTIVE does not).
/// The database does not enforce that; the service's single terminate operation sets both.
model Employee {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The code HR knows the person by, for example EMP-00001.
  employeeCode String         @unique @map("employee_code")
  fullName     String         @map("full_name")
  gender       Gender
  jobTitle     String         @map("job_title")
  /// 1 is the most junior. Salary bands and the pay-by-level insights use it.
  level        Int
  departmentId String         @map("department_id") @db.Uuid
  countryId    String         @map("country_id") @db.Uuid
  joiningDate  DateTime       @map("joining_date") @db.Date
  status       EmployeeStatus @default(ACTIVE)
  /// The last day, set only when status is TERMINATED.
  terminatedOn DateTime?      @map("terminated_on") @db.Date
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@map("employees")
}
