// Prisma schema. The datasource URL lives in prisma.config.ts (Prisma 7).
// The client is generated inside src/ so `nest build` compiles it into dist/.
//
// Conventions
// - Tables and columns are snake_case (@@map / @map) so raw SQL for the insight
//   queries stays readable. Enum types are mapped the same way.
// - Ids are UUIDs generated by Postgres (gen_random_uuid()).
//
// The schema is built up one table at a time; each addition is reviewed and
// gets its own migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_ADMIN
  EMPLOYEE

  @@map("user_role")
}

enum Gender {
  FEMALE
  MALE
  OTHER

  @@map("gender")
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED

  @@map("employee_status")
}

enum SalaryChangeReason {
  HIRE
  PROMOTION
  MERIT
  MARKET_ADJUSTMENT
  CORRECTION

  @@map("salary_change_reason")
}

/// A login account. Only HR_ADMIN is used in v1; EMPLOYEE is reserved for later self-service.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  salaryChanges SalaryRecord[]

  @@map("users")
}

/// One refresh token per row. Only the SHA-256 hash is stored, never the token itself.
/// Every token issued by one login shares a family_id; presenting an already-revoked token
/// revokes the whole family (reuse detection).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 hex digest (64 characters).
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token is rotated or the user logs out. Null means still active.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Reference data loaded by the seed. One currency per country.
model Country {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ISO 3166-1 alpha-2, upper case (for example IN).
  code         String @unique @db.Char(2)
  name         String
  /// ISO 4217, upper case (for example INR). Several countries may share one.
  currencyCode String @map("currency_code") @db.Char(3)

  employees   Employee[]
  salaryBands SalaryBand[]

  @@map("countries")
}

/// Reference data loaded by the seed.
model Department {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  employees Employee[]

  @@map("departments")
}

/// A person ACME employs, or has employed. Leavers are marked TERMINATED and kept,
/// never deleted, so their salary history stays intact; that is why the two relations
/// below restrict deletes.
///
/// There are no secondary indexes yet, on purpose: they are added after the
/// 10,000-employee seed, only where EXPLAIN shows a need, and the before and after
/// are recorded in docs/performance.md.
///
/// status and terminated_on belong together (TERMINATED has a date, ACTIVE does not).
/// The database does not enforce that; the service's single terminate operation sets both.
model Employee {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The code HR knows the person by, for example EMP-00001.
  employeeCode String         @unique @map("employee_code")
  fullName     String         @map("full_name")
  gender       Gender
  jobTitle     String         @map("job_title")
  /// 1 is the most junior. Salary bands and the pay-by-level insights use it.
  level        Int
  departmentId String         @map("department_id") @db.Uuid
  countryId    String         @map("country_id") @db.Uuid
  joiningDate  DateTime       @map("joining_date") @db.Date
  status       EmployeeStatus @default(ACTIVE)
  /// The last day, set only when status is TERMINATED.
  terminatedOn DateTime?      @map("terminated_on") @db.Date
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)

  salaryRecords SalaryRecord[]

  @@map("employees")
}

/// One salary an employee has been on, from effectiveFrom. Append-only: a salary is
/// never edited or deleted; a change, or the correction of a mistake, is a new record.
/// The current salary is the latest effectiveFrom up to today, with ties going to the
/// newest createdAt, so a correction can share the date of the record it fixes.
///
/// There are no secondary indexes yet, on purpose (see Employee). The likely first one is
/// (employee_id, effective_from DESC), added once the salary history is seeded and the
/// query plans show a need. annual_amount > 0 is validated by the API, because Prisma
/// cannot express that check without hand-written SQL.
model SalaryRecord {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String              @map("employee_id") @db.Uuid
  /// Annual gross base pay, in currencyCode. A decimal, never a float.
  annualAmount  Decimal             @map("annual_amount") @db.Decimal(14, 2)
  /// ISO 4217, upper case. Stored on every record so the history keeps its meaning
  /// if the employee later moves to another country.
  currencyCode  String              @map("currency_code") @db.Char(3)
  effectiveFrom DateTime            @map("effective_from") @db.Date
  /// Why the salary changed. Null when no reason was given, for example in a
  /// spreadsheet upload; the API requires one for a change made in the app.
  reason        SalaryChangeReason?
  /// Who recorded it. Null when the seed loaded it. A user who changed a salary
  /// cannot be deleted, so the audit trail survives.
  changedById   String?             @map("changed_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@map("salary_records")
}

/// The pay range for one level in one country, in that country's currency and in the
/// same unit as salary_records.annual_amount (annual gross). Reference data loaded by
/// the seed. One band per country and level, the same for every department, so a
/// department that pays below the country norm shows up as under the band.
/// min_amount < max_amount is validated by the API (Prisma cannot express the check).
model SalaryBand {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  /// 1 is the most junior, as in employees.level.
  level     Int
  minAmount Decimal @map("min_amount") @db.Decimal(14, 2)
  maxAmount Decimal @map("max_amount") @db.Decimal(14, 2)

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, level])
  @@map("salary_bands")
}

/// How many units of a currency one US dollar buys, from valid_from, so a USD amount is
/// amount / units_per_usd (the USD row is 1). Reference data loaded by the seed; the
/// rates are illustrative, not market data. Dated, so a later rate can be added without
/// losing the old one, and not tied to a country: a country's currency selects the row.
model FxRate {
  currencyCode String   @map("currency_code") @db.Char(3)
  validFrom    DateTime @map("valid_from") @db.Date
  unitsPerUsd  Decimal  @map("units_per_usd") @db.Decimal(18, 8)

  @@id([currencyCode, validFrom])
  @@map("fx_rates")
}
