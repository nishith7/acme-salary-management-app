# Copy to .env and fill in. Never commit .env.

# Pooled connection string (host contains "-pooler"): used by the running API
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full

# Direct connection string (same host without "-pooler"): used by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full

# Secret used to sign access tokens (HS256). At least 32 characters; the app
# refuses to start otherwise. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Use a different value in every environment.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
