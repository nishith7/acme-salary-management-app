# Copy to .env and fill in. Never commit .env.

# Pooled connection string (host contains "-pooler"): used by the running API
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full

# Direct connection string (same host without "-pooler"): used by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full
