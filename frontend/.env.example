# Copy to .env.local to override. Every value is optional.

# Base URL of the API, read by the API client (next step). Leave it as /api when a proxy
# (Vite in development, Vercel or similar in production) forwards /api/* to the backend.
# Set the full API URL (https://...) when the site is served from a different host, such
# as GitHub Pages.
VITE_API_URL=/api

# Where the site is served from. "/" everywhere except GitHub Pages, whose project sites
# live under /<repository>/ (the Pages workflow sets this itself).
VITE_BASE_PATH=/

# Development only: where Vite's /api proxy forwards to.
DEV_API_URL=http://localhost:3000
