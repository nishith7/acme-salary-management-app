# Copy to .env (git ignores it) and change what differs on your machine. Same convention
# as backend/.env.example. Nothing here is a secret.

# --- Required -------------------------------------------------------------------------

# The address of the backend API. The browser calls it directly, so this is where the
# backend listens: http://localhost:<PORT>, with PORT as in backend/.env (default 3000).
# There is no default, so a wrong guess can never hide. The backend must also allow this
# site: its CORS_ORIGINS (backend/.env) must list the address the frontend is served from,
# http://localhost:5173 in development.
VITE_API_URL=http://localhost:3000

# --- Optional -------------------------------------------------------------------------

# Where the site is served from. "/" everywhere except GitHub Pages, whose project sites
# live under /<repository>/ (the Pages workflow sets this itself).
VITE_BASE_PATH=/
